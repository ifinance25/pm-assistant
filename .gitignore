# зависимости
node_modules/

# секреты: имена переменных лежат в .env.example, значения не коммитим
.env
.env.local

# рабочие данные: база встреч и записи звонков остаются на машине
app/data/

# сборка
dist/

# macOS
.DS_Store

# автопилот: рабочие файлы orchestration-скилла, не часть проекта
.autopilot/

# временные экспорты дизайн-макетов и тестовые записи реальных встреч — не версионируем новые
artifacts/designs/**/exports-tmp/
artifacts/audio-regression-*/

# рабочий мусор инструментов: логи, pid-файлы, кэш Python
*.log
*.pid
__pycache__/
*.pyc
app/.playwright-cli/
