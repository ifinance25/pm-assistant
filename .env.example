# Скопировать в `.env` (локально) или в `/etc/pm-assistant.env` на сервере.
# Файл `.env` в git не попадает. Значения сюда не вписывать.

# --- Claude Agent SDK: подписка, не ключ Console ---
# Инструкция: artifacts/2026-09-03-claude-agent-sdk-subscription-on-server.md
# Токен: на Mac выполнить `claude setup-token`, вставить сюда.
CLAUDE_CODE_OAUTH_TOKEN=

# Не задавать на машине, где должен работать этот токен.
# Если задать, Claude уйдёт в оплату API (Console), подписка игнорируется.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# --- Первая сдача: имена есть, значения можно оставить пустыми (заглушки) ---
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_BOT_NAME=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Один client для входа и Google Календаря (ADR .autopilot/spec.md §8)
PM_ASSISTANT_GOOGLE_REDIRECT_URI=

# --- v2 Auth: локальный вход (seed одного пользователя при старте БД) ---
PM_ASSISTANT_AUTH_EMAIL=
PM_ASSISTANT_AUTH_PASSWORD=
PM_ASSISTANT_AUTH_DISPLAY_NAME=
# Разрешённые email для входа (через запятую). PM_ASSISTANT_AUTH_EMAIL добавляется автоматически.
PM_ASSISTANT_AUTH_ALLOWLIST=
# 1: cookie сессии с флагом Secure (если вход только по HTTPS)
# PM_ASSISTANT_COOKIE_SECURE=

# Запасной путь LLM по факту использования. Для сервера на подписке не нужен.
OPENAI_API_KEY=
# Cursor API key (Dashboard → API Keys). Воркер вызывает локальный CLI `agent`.
# Старый alias: CURSOR_AUTH_TOKEN
CURSOR_API_KEY=
# Kimi / Moonshot API (platform.moonshot.cn). Alias: MOONSHOT_API_KEY
KIMI_API_KEY=
# Опционально для Kimi: https://api.moonshot.cn/v1 или https://api.moonshot.ai/v1
KIMI_BASE_URL=
KIMI_MODEL=
# Путь к бинарнику Cursor CLI (по умолчанию ~/.local/bin/agent)
# PM_ASSISTANT_CURSOR_AGENT_BIN=
# Таймаут одного вызова Cursor CLI, мс (по умолчанию 180000)
PM_ASSISTANT_CURSOR_AGENT_TIMEOUT_MS=

# Распознавание речи (на EC2 уже стоит whisper.cpp tiny)
WHISPER_BIN=
WHISPER_CLI=
WHISPER_MODEL=
ZOOM_BOT_RUNTIME=
ZOOM_BOT_IMAGE=
PM_ASSISTANT_DB_PATH=

# --- v2 Трекеры задач (OAuth stub + PAT по типу, default ClickUp в настройках) ---
ASANA_PAT=
TRELLO_API_KEY=
CLICKUP_API_TOKEN=
NOTION_API_KEY=

# Публичный HTTP API (Bearer)
APP_API_TOKEN=
