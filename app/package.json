{
  "name": "pm-assistant",
  "private": true,
  "version": "0.2.9",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env src/server/dev.ts",
    "worker": "node --env-file=.env src/worker/index.ts",
    "zoom:join": "node --env-file=.env src/adapters/platform/zoom-cli.ts",
    "mcp": "node src/mcp/index.ts",
    "transcribe": "node src/worker/transcribe-cli.ts",
    "test": "tsc --noEmit && vitest run",
    "lint": "biome check src bot --files-ignore-unknown=true",
    "build": "vite build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
